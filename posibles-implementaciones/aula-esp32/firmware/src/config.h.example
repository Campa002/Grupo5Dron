#ifndef CONFIG_H
#define CONFIG_H

#include <Arduino.h>

// ============================================================
// 1. ASIGNACIÓN DE PINES (GPIO) — circuito soldado (ESP32 NodeMCU de 30 pines)
// ============================================================
//
//  GPIO 18 -> resistencia de 330 Ω -> base de un BC337 (emisor IR)
//             5 V -> (33 Ω en paralelo con 100 Ω) -> LED IR 1 -> LED IR 2 -> colector del BC337
//             emisor del BC337 -> GND
//  GPIO 26 -> IN del módulo relé (luces del aula: corta solo la fase; COM entra, NO sale, NC vacío)
//  GPIO 15 <- OUT del receptor KY-022 (VCC del KY-022 a 3V3 y GND a GND)
//  VIN / GND <- +Vo / -Vo de la fuente HLK-5M05 (5 V para el ESP32, el relé y los LEDs)
//
// Notas:
//  - GPIO 15 es un pin de arranque: solo decide si el ESP32 muestra los mensajes de arranque por el
//    puerto serie. El KY-022 en reposo da nivel alto, que es el normal: arranca bien.
//  - Corriente de los LEDs: ~80 mA de pico (2 LEDs de ~1,35 V y ~25 Ω), ~25-30 mA de promedio con la
//    portadora de 38 kHz. Base del BC337: ~7,7 mA (lo satura bien).

// Emisor IR: base del BC337 (a través de 330 Ω). El transistor maneja los 2 LEDs en serie a 5 V.
#define PIN_IR_SEND        18

// Receptor IR KY-022 (38 kHz), alimentado a 3V3
#define PIN_IR_RECV        15

// Relé de las luces del aula (220 V)
#define PIN_RELE_LUCES     26

// LED indicador de estado en placa (GPIO 2 en el NodeMCU)
#define PIN_LED_ESTADO     2

// ============================================================
// 2. NIVEL DEL MÓDULO RELÉ
// ============================================================
// Hay módulos que se activan con nivel BAJO (LOW) y otros con nivel ALTO (HIGH); algunos traen un jumper "H/L".
// Cómo averiguarlo: con el ESP32 desconectado, alimentá el módulo a 5 V (VCC y GND) y tocá IN con un cable:
//  - si hace clic al tocar GND  -> es activo en BAJO -> RELE_ACTIVO_EN_BAJO 1
//  - si hace clic al tocar 3V3  -> es activo en ALTO -> RELE_ACTIVO_EN_BAJO 0
// En los dos casos el relé arranca APAGADO: el firmware escribe el nivel "apagado" antes de configurar el pin,
// y mientras el ESP32 bootea el pin queda flotando (el módulo lo toma como apagado).
// Ojo: un módulo activo en BAJO alimentado a 5 V puede no apagarse del todo con los 3,3 V del ESP32
// (queda prendido o tiembla). Si pasa, se arregla con el jumper o con un transistor, no con el código.
#define RELE_ACTIVO_EN_BAJO  1

#if RELE_ACTIVO_EN_BAJO
#define RELAY_ACTIVE_LEVEL   LOW
#define RELAY_INACTIVE_LEVEL HIGH
#else
#define RELAY_ACTIVE_LEVEL   HIGH
#define RELAY_INACTIVE_LEVEL LOW
#endif

// ============================================================
// 3. CONECTIVIDAD WI-FI
// ============================================================
#define WIFI_SSID          "TU_RED_WIFI"
#define WIFI_PASSWORD      "TU_CLAVE_WIFI"

// Tiempo máximo de espera para conexión inicial antes de reintentar (ms)
#define WIFI_TIMEOUT_MS    15000

// Intervalo de verificación y reconexión automática (ms)
#define WIFI_RECONNECT_INTERVAL_MS 5000

// ============================================================
// 4. API REST & AUTENTICACIÓN
// ============================================================
// URL completa al endpoint de esp32.php (debe usar HTTPS en producción)
// Ej: "https://tudominio.com/api/esp32.php" o "http://192.168.1.100:8088/api/esp32.php"
#define API_URL            "https://tu-dominio.com/api/esp32.php"

// Token secreto del dispositivo (debe coincidir con esp32_token en config.php del backend)
#define ESP32_TOKEN        "CAMBIAR_TOKEN_ESP32_SECRETO"

// Identificador único de este ESP32 en la base de datos
#define DISPOSITIVO_ID     "esp32-principal"

// Versión del Firmware reportada en el heartbeat
#define FIRMWARE_VERSION   "1.1.0"

// ============================================================
// 5. SEGURIDAD HTTPS (WiFiClientSecure) & CERTIFICADOS RAÍZ
// ============================================================
// Para entornos de prueba o desarrollo local sin certificado SSL válido,
// poner en true para usar client.setInsecure().
// ⚠️ ADVERTENCIA: CLIENT_INSECURE_MODE en true NO valida el certificado del
// servidor, permitiendo ataques Man-in-the-Middle en redes públicas.
// En producción, poner en false e incluir el certificado raíz CA (ROOT_CA_CERT).
//
// 📌 GUÍA: ¿QUÉ CERTIFICADO RAÍZ USAR SEGÚN EL PROVEEDOR DE HOSTING?
//  1. Let's Encrypt (cPanel AutoSSL o Certbot):
//     - Certificado Raíz: "ISRG Root X1" (incluido por defecto abajo). Válido hasta 2035.
//  2. cPanel (Sectigo / Comodo AutoSSL):
//     - Certificado Raíz: "USERTrust RSA Certification Authority" o "AAA Certificate Services".
//  3. Google Trust Services (cPanel moderno):
//     - Certificado Raíz: "GTS Root R1" o "GTS Root R2".
//  4. Cloudflare (Proxy SSL Flexible / Full):
//     - Certificado Raíz: "Cloudflare Origin CA" o "DigiCert Global Root CA".
//
// CÓMO OBTENER EL CERTIFICADO EXACTO DE TU HOSTING:
//  1. Abrí la URL de tu API en Chrome o Edge (ej: https://tuhosting.com/api/esp32.php).
//  2. Hacé clic en el ícono del candado junto a la URL -> "La conexión es segura" -> "Certificado".
//  3. Andá a la pestaña "Ruta de certificación" y seleccioná el nodo superior (el Certificado Raíz).
//  4. Exportalo en formato "X.509 codificado base 64 (.CER / .PEM)" y pegá su contenido abajo.
//
#define CLIENT_INSECURE_MODE true

