// ============================================================
// 6. TIEMPOS Y TEMPORIZACIÓN (ms)
// ============================================================
// Intervalo de consulta a la cola de comandos pendientes (default: 2s)
#define POLLING_INTERVAL_MS        2000

// Intervalo de reporte de latido (en línea)
#define HEARTBEAT_INTERVAL_MS      10000

// Timeout para peticiones HTTP/HTTPS (ms) - Corto para no trabar el loop
#define HTTP_TIMEOUT_MS            3000

// Tiempo que permanece activo el receptor en modo aprendizaje (ms)
#define APRENDIZAJE_TIMEOUT_MS     15000

// Velocidad del puerto serial para depuración
#define SERIAL_BAUD_RATE           115200

#endif // CONFIG_H
