/**
 * Configuración del Firmware — Grupo 5: Control de Sistemas y Dron
 * EEST N° 1 de Vicente López "Eduardo Ader" — 7° 2°
 * 
 * INSTRUCCIONES:
 * 1. Copiá este archivo como "config.h" en esta misma carpeta (firmware/src/).
 * 2. Completá los datos de red WiFi, URL de la API y token de dispositivo.
 * 3. NUNCA subas config.h al repositorio git (está incluido en .gitignore).
 */

#ifndef CONFIG_H
#define CONFIG_H

#include <Arduino.h>

// ============================================================
// 1. ASIGNACIÓN DE PINES (GPIO)
// ============================================================

// LED Emisor Infrarrojo (Transistor NPN o MOSFET sugerido)
// ⚠️ NO usar GPIO35 (es solo entrada) ni GPIO2 (pin de boot/strapping).
#define PIN_IR_LED         4

// Receptor Infrarrojo (Módulo VS1838B o similar a 38 kHz)
#define PIN_IR_RECV        15

// Control de Relé 1 (220V - Iluminación o Cargas del Aula)
#define PIN_RELAY_1        26

// Control de Relé 2 (Opcional - Tomas o Circuitos Auxiliares)
#define PIN_RELAY_2        27

// LED indicador de estado en placa (habitualmente GPIO2 en DevKit v1)
#define PIN_LED_ESTADO     2

// ============================================================
// 2. CONFIGURACIÓN DEL MÓDULO DE RELÉ
// ============================================================
// La mayoría de los módulos de relé de 1/2/4 canales para Arduino/ESP32
// con optoacoplador son ACTIVO-BAJO (LOW = Relé cerrado/activado,
// HIGH = Relé abierto/apagado).
// Si tu módulo es activo-alto, invertí estos valores:
#define RELAY_ACTIVE_LEVEL   LOW
#define RELAY_INACTIVE_LEVEL HIGH

// ============================================================
// 3. CONECTIVIDAD WI-FI
// ============================================================
#define WIFI_SSID          "TU_RED_WIFI"
#define WIFI_PASSWORD      "TU_CLAVE_WIFI"

// Tiempo máximo de espera para conexión inicial antes de reintentar (ms)
#define WIFI_TIMEOUT_MS    15000

// Intervalo de verificación y reconexión automática (ms)
#define WIFI_RECONNECT_INTERVAL_MS 5000

// ============================================================
// 4. API REST & AUTENTICACIÓN
// ============================================================
// URL completa al endpoint de esp32.php (debe usar HTTPS en producción)
// Ej: "https://tudominio.com/api/esp32.php" o "http://192.168.1.100:8088/api/esp32.php"
#define API_URL            "https://tu-dominio.com/api/esp32.php"

// Token secreto del dispositivo (debe coincidir con esp32_token en config.php del backend)
#define ESP32_TOKEN        "CAMBIAR_TOKEN_ESP32_SECRETO"

// Identificador único de este ESP32 en la base de datos
#define DISPOSITIVO_ID     "esp32-principal"

// Versión del Firmware reportada en el heartbeat
#define FIRMWARE_VERSION   "1.0.0"

// ============================================================
// 5. SEGURIDAD HTTPS (WiFiClientSecure)
// ============================================================
// Para entornos de prueba o desarrollo local sin certificado SSL válido,
// poner en true para usar client.setInsecure().
// ⚠️ ADVERTENCIA: CLIENT_INSECURE_MODE en true NO valida el certificado del
// servidor, permitiendo ataques Man-in-the-Middle en redes públicas.
// En producción, poner en false e incluir el certificado raíz (ROOT_CA_CERT).
#define CLIENT_INSECURE_MODE true

